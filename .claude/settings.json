{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git ls-files *)",
      "Bash(git cat-file *)",
      "Bash(pnpm install *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm format *)",
      "Bash(pnpm build *)",
      "Bash(pnpm check *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm run *)",
      "Bash(pnpm --filter *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo build *)",
      "Bash(cargo run *)",
      "Bash(./gradlew *)",
      "Bash(gradlew *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git config *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p8)",
      "Read(**/*.asc)",
      "Read(**/*.gpg)",
      "Read(**/key.properties)",
      "Read(**/keystore.properties)",
      "Read(**/signing.properties)",
      "Read(**/id_rsa)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(**/secrets/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.js\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking command against repo guards"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edit.js\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking file against repo guards"
          }
        ]
      }
    ]
  }
}
