{
  "name": "pulse",
  "version": "0.0.0",
  "private": true,
  "description": "Pulse work-hours tracker: NestJS server, Tauri desktop app, Android app and shared Rust core.",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "verify": "pnpm install --frozen-lockfile && node scripts/check.mjs",
    "check": "node scripts/check.mjs",
    "dev": "node scripts/dev.mjs start",
    "dev:up": "node scripts/dev.mjs up",
    "dev:down": "node scripts/dev.mjs down",
    "dev:reset": "node scripts/dev.mjs reset",
    "dev:seed": "pnpm --filter @pulse/server seed",
    "format": "prettier --write .",
    "lint": "eslint --max-warnings 0 ."
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.0"
  }
}
