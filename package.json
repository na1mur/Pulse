{
  "name": "Pulse",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "mobile:build:android": "pnpm --filter mobile build:android:preview"
  },
  "devDependencies": {
    "png-to-ico": "^2.1.8",
    "prettier": "^3.7.4",
    "sharp": "^0.34.3",
    "turbo": "^2.10.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.0.0"
}
