{
  "description": "dayBounds: the half-open interval [start, end) of a local day, where a day starts at its first instant with that local date (01:00 when midnight is skipped) and ends where the next day starts. seconds = end - start (23 h and 25 h on DST days).",
  "rules": ["R-10", "R-11"],
  "cases": [
    {
      "name": "UTC ordinary day",
      "input": {
        "day": "2026-10-25",
        "timeZone": "UTC"
      },
      "expected": {
        "start": "2026-10-25T00:00:00Z",
        "end": "2026-10-26T00:00:00Z",
        "seconds": 86400
      }
    },
    {
      "name": "UTC leap day 2028-02-29 ends at March 1",
      "input": {
        "day": "2028-02-29",
        "timeZone": "UTC"
      },
      "expected": {
        "start": "2028-02-29T00:00:00Z",
        "end": "2028-03-01T00:00:00Z",
        "seconds": 86400
      }
    },
    {
