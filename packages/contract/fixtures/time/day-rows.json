{
  "description": "dayRows: a session [startedAt, endedAt) or, while running (endedAt null), [startedAt, now), in its own timezone, split into one row per local day with more than 0 seconds. Instants are floored to whole seconds first, so the rows sum to the session's duration. localStart/localEnd are HH:MM:SS wall-clock times; a row ending at its day's end shows the day's last second (23:59:59). now only clips running sessions.",
  "rules": ["R-09", "R-11", "R-16", "R-17"],
  "cases": [
    {
      "name": "UTC session within one day gives one row",
      "input": {
        "startedAt": "2026-10-25T09:00:00Z",
        "endedAt": "2026-10-25T10:30:00Z",
        "timeZone": "UTC",
        "now": "2026-10-25T12:00:00Z"
      },
      "expected": {
        "rows": [
          {
            "day": "2026-10-25",
            "start": "2026-10-25T09:00:00Z",
            "end": "2026-10-25T10:30:00Z",
            "seconds": 5400,
            "localStart": "09:00:00",
            "localEnd": "10:30:00"
          }
        ]
      }
    },
    {
      "name": "UTC session across midnight gives two rows that sum to the session",
      "input": {
        "startedAt": "2026-10-24T22:00:00Z",
        "endedAt": "2026-10-25T01:30:00Z",
        "timeZone": "UTC",
        "now": "2026-10-25T12:00:00Z"
      },
      "expected": {
        "rows": [
          {
            "day": "2026-10-24",
            "start": "2026-10-24T22:00:00Z",
            "end": "2026-10-25T00:00:00Z",
            "seconds": 7200,
            "localStart": "22:00:00",
            "localEnd": "23:59:59"
          },
          {
            "day": "2026-10-25",
            "start": "2026-10-25T00:00:00Z",
            "end": "2026-10-25T01:30:00Z",
            "seconds": 5400,
            "localStart": "00:00:00",
            "localEnd": "01:30:00"
          }
        ]
      }
    },
