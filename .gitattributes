# Normalise line endings: LF in the repo and the working tree on every OS.
* text=auto eol=lf

# Windows scripts need CRLF (includes gradlew.bat)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.so binary
*.dll binary
*.exe binary
*.zip binary
*.gz binary
*.db binary
*.sqlite binary
# Signing material is never committed (.gitignore, edit guard); if one ever appears, never mangle it.
*.keystore binary
*.jks binary

# Lockfiles: collapsed in GitHub diffs
pnpm-lock.yaml linguist-generated=true
Cargo.lock linguist-generated=true
