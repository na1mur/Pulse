# Pulse server configuration (spec Appendix A "Server configuration (.env)").
# Copy to infra/.env and fill in; infra/.env is never committed.
# The server validates this at start and refuses missing, weak or placeholder secrets (OPS-03).
# Generate each secret with: openssl rand -base64 48

# --- Database (OPS-01) ---
# External PostgreSQL URL, e.g. postgres://pulse:<password>@db.example.com:5432/pulse
# Leave empty to use the bundled database (Compose profile `db`, data on a named volume).
DATABASE_URL=
# Password of the bundled database. Required when DATABASE_URL is empty, ignored otherwise.
DB_PASSWORD=

# --- Sign-in tokens (required) ---
# Signs access tokens.
JWT_SECRET=
# HMAC key for stored refresh-token hashes. Must differ from JWT_SECRET.
REFRESH_SECRET=

# --- Public address ---
# Port the server listens on inside its container.
PORT=3000
# Base URL the apps and email links use. With DOMAIN set: https://<DOMAIN>
PUBLIC_API_URL=https://pulse.example.com

# --- Google sign-in (AUTH-11) ---
# OAuth client from the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email over SMTP (OPS-07): verification, password reset, email change ---
# Defaults are Gmail: SMTP_USER is the Gmail address, SMTP_APP_PASSWORD a Gmail app password
# (Google account > Security > App passwords; needs 2-step verification).
SMTP_HOST=smtp.gmail.com
# 465 = TLS from the start; 587 = STARTTLS.
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
# Sender name and address. Gmail only sends as SMTP_USER or one of its verified aliases.
MAIL_FROM="Pulse <pulse@example.com>"

# --- Android push via Firebase Cloud Messaging (NOTIF-04, optional) ---
# From a Firebase service-account key. Leave all three empty to run without push (D-23).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# The key's private_key value on one line, newlines written as \n, in double quotes.
FCM_PRIVATE_KEY=

# --- HTTPS reverse proxy (OPS-06, optional) ---
# Domain Caddy gets a certificate for (Compose profile `proxy`). Its DNS must point at this host.
DOMAIN=

# --- CORS and proxy trust (OPS-03) ---
# Comma-separated browser origins allowed to call the API. Empty = none (the apps do not need CORS).
CORS_ORIGINS=
# Reverse proxies in front of the server whose X-Forwarded-* headers are trusted:
# 0 = none (server exposed directly), 1 = one proxy (the bundled Caddy, or your own).
TRUST_PROXY=0
