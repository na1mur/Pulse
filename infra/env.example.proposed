# Pulse server settings for infra/docker-compose.yml. Copy this file to `.env` in the same folder
# (cp .env.example .env), fill in the lines marked REQUIRED and leave the rest as it is. Never commit
# `.env`; it holds your secrets. Every value here is a placeholder, nothing in this file is a
# working default for a secret.
#
# Variable names and defaults come from the spec (Appendix A); the server checks all of them when it
# starts and refuses to start, naming the problem, if one is wrong. An empty value counts as unset.
# A `$` inside a value must be written `$$`. Generating a secret needs only openssl:
#   openssl rand -hex 32
# or, where you have Node:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- which parts run ----------------------------------------------------------------------------
# Compose profiles, separated by commas:
#   db      the bundled PostgreSQL (data on the Docker volume `db-data`). Needs DB_PASSWORD, and
#           DATABASE_URL must stay empty. Remove `db` when you use an external database.
#   https   Caddy, with automatic HTTPS for DOMAIN. Needs DOMAIN, ports 80 and 443 reachable from
#           the internet and TRUST_PROXY=1. Add it as `db,https`.
COMPOSE_PROFILES=db

# ---- database -----------------------------------------------------------------------------------
# Empty: use the bundled database (profile `db`). To use an external PostgreSQL instead, set this to
# its address, for example postgres://pulse:PASSWORD@db.example.org:5432/pulse (PASSWORD must be
# URL-safe, or percent-encoded), and remove `db` from COMPOSE_PROFILES. The database user must be
# able to create tables; Pulse creates and updates its own schema when the server starts.
DATABASE_URL=

# REQUIRED with the bundled database: its password, 12 or more characters, URL-safe (the command
# below gives hex). The bundled database takes it over once, when its volume is created: changing it
# later does not change the database (README.md, "Changing the database password").
#   sed -i "s|^DB_PASSWORD=.*|DB_PASSWORD=$(openssl rand -hex 24)|" .env
DB_PASSWORD=

# ---- secrets (REQUIRED) -------------------------------------------------------------------------
# JWT_SECRET signs access tokens, REFRESH_SECRET keys the hash of refresh tokens. Each needs 32 or
# more characters, they must differ, and neither may be a placeholder like `changeme`. Changing one
# later signs every device out.
#   sed -i "s|^JWT_SECRET=.*|JWT_SECRET=$(openssl rand -hex 32)|" .env
#   sed -i "s|^REFRESH_SECRET=.*|REFRESH_SECRET=$(openssl rand -hex 32)|" .env
JWT_SECRET=
REFRESH_SECRET=

# ---- address ------------------------------------------------------------------------------------
# REQUIRED: the address the apps and the links in emails use, with no trailing slash:
# https://pulse.example.org with the `https` profile, http://<server address>:3000 for a test.
PUBLIC_API_URL=http://localhost:3000

# Host name for the `https` profile, no scheme or port, for example pulse.example.org. Its DNS record
# must point at this machine before you start Caddy.
DOMAIN=

# Number of reverse proxies in front of the server: 1 with the `https` profile or your own reverse
# proxy, 0 when clients connect to the server directly. With 1 the server believes the client
# address that the proxy reports; with 0 it ignores those headers.
TRUST_PROXY=0

# Browser origins allowed to call the API, comma-separated, exact (https://app.example.org), no
# `*`. The Windows and Android apps need none; leave empty unless you serve a web client.
CORS_ORIGINS=

# Port the server listens on inside its container, and on the host (3000 by default).
#PORT=3000

# Address the server's port is published on. The default, 127.0.0.1, makes it reachable from this
# machine only (the way in from outside is Caddy or your own reverse proxy). 0.0.0.0 publishes plain
# HTTP to the whole network: for a short test only.
#PULSE_BIND_ADDRESS=127.0.0.1

# ---- email (optional until you want sign-up emails) ---------------------------------------------
# Gmail with an app password: https://myaccount.google.com/apppasswords. Both lines, or neither.
SMTP_USER=
SMTP_APP_PASSWORD=
# Another provider: its host and port (the defaults are Gmail's smtp.gmail.com and 465), and the
# address emails come from (the default is SMTP_USER).
SMTP_HOST=
SMTP_PORT=
MAIL_FROM=

# ---- Google sign-in (optional) ------------------------------------------------------------------
# From a Google Cloud OAuth client. Both lines, or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- push notifications through Firebase (optional) ---------------------------------------------
# All three, or none. FCM_PRIVATE_KEY is the service account's key on one line inside single quotes,
# with \n for each line break.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---- advanced -----------------------------------------------------------------------------------
# The server image to run. By default Compose builds it from this repository as `pulse-server:local`.
#PULSE_IMAGE=pulse-server:local
