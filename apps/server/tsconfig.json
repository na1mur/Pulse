{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    // NestJS dependency injection reads constructor parameter types from legacy decorator metadata.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src", "vitest.config.ts"]
}
