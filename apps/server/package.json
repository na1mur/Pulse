{
  "name": "@pulse/server",
  "version": "0.0.0",
  "private": true,
  "description": "Pulse API, realtime gateway, mail and push (NestJS).",
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "build": "nest build",
    "dev": "pnpm --filter @pulse/contract build && nest start --watch",
    "start": "node dist/main.js",
    "seed": "node scripts/seed/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@pulse/contract": "workspace:*",
    "kysely": "0.29.7",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "temporal-polyfill": "1.0.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "mailparser": "3.12.4",
    "smtp-server": "3.21.1",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  }
}
