# Copy to .env.local to override defaults, or edit .env.development / .env.production.
# Expo inlines EXPO_PUBLIC_* at build time — restart `expo start` after changes.

# Local API (default for `expo start`)
# EXPO_PUBLIC_API_URL=http://localhost:3001

# Deployed EC2 API (default for production / EAS builds)
# EXPO_PUBLIC_API_URL=https://pulse-be.duckdns.org
