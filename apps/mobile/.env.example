# Expo env load order (highest priority first):
#   .env.development.local
#   .env.local              ← use this to override API URL in `expo start`
#   .env.development
#   .env
#
# Production builds use .env.production.
# Restart `expo start -c` after changes.
#
# Env files must live in apps/mobile/ (not the monorepo root).

# Local API
# EXPO_PUBLIC_API_URL=http://localhost:3001

# Deployed EC2 API
# EXPO_PUBLIC_API_URL=https://pulse-be.duckdns.org
