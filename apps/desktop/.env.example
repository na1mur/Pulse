# Vite env load order (highest priority first):
#   .env.development.local  ← use this to override API URL in `pnpm dev`
#   .env.development
#   .env.local              ← NOT used by Vite when .env.development exists
#   .env
#
# Production builds (`pnpm build`, `pnpm dist:win`) use .env.production.
# Restart `pnpm dev` after changes.

# Local API
# VITE_API_URL=http://localhost:3001

# Deployed EC2 API
# VITE_API_URL=https://pulse-be.duckdns.org
