# Vite env load order for `pnpm dev` (highest priority first):
#   .env.development.local  ← overrides everything in dev (use for prod API testing)
#   .env.development        ← default local API URL
#   .env.local
#   .env
#
# Production builds (`pnpm build`, `pnpm dist:win`) use .env.production.
# Restart `pnpm dev` after changes.

# Local API
# VITE_API_URL=http://localhost:3001

# Deployed EC2 API
# VITE_API_URL=https://pulse-be.duckdns.org
