# Copy to .env.local to override defaults, or edit .env.development / .env.production.
# Vite inlines VITE_* at build time — restart `pnpm dev` after changes.

# Local API (default for `pnpm dev`)
# VITE_API_URL=http://localhost:3001

# Deployed EC2 API (default for `pnpm build` / packaged desktop app)
# VITE_API_URL=https://pulse-be.duckdns.org
