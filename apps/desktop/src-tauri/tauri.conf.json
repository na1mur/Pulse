{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "identifier": "com.naimur-rahman.pulse",
  "build": {
    "beforeDevCommand": "pnpm --filter @pulse/desktop dev",
    "beforeBuildCommand": "pnpm --filter @pulse/desktop build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pulse",
        "width": 480,
        "height": 640,
        "minWidth": 480,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
