<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: nothing is copied by cloud backup or device-to-device transfer. The server holds
    the user's data; the device keeps only a cache, the outbox and credentials, which a restore
    onto another device must not bring back. Older versions: android:allowBackup="false".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
